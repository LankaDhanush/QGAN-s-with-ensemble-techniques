{"cells":[{"cell_type":"code","source":["!pip install pennylane torch torchvision numpy matplotlib tqdm scipy torchmetrics[image] --quiet\n","\n","from google.colab import drive\n","drive.mount('/content/drive')\n","\n","import os, csv, datetime\n","from pathlib import Path\n","import torch\n","import torch.nn as nn\n","import torch.optim as optim\n","import torch.nn.functional as F\n","from torch.utils.data import DataLoader\n","from torchvision import datasets, transforms\n","import torchvision.utils as vutils\n","import pennylane as qml\n","import torchvision.models as models\n","import numpy as np\n","import warnings\n","warnings.filterwarnings(\"ignore\", category=UserWarning)\n","\n","# ======================\n","# 🔹 Generator (Hybrid Quantum-Classical)\n","# ======================\n","class QuantumGenerator(nn.Module):\n","    def __init__(self, latent_dim: int = 16, n_qubits: int = 4, q_depth: int = 2, out_channels: int = 1):\n","        super().__init__()\n","        self.pre = nn.Linear(latent_dim, n_qubits)\n","\n","        dev = qml.device(\"default.qubit\", wires=n_qubits)\n","        weight_shapes = {\"weights\": (q_depth, n_qubits, 3)}\n","\n","        @qml.qnode(dev, interface=\"torch\", diff_method=\"backprop\")\n","        def qnode(inputs, weights):\n","            qml.AngleEmbedding(inputs, wires=range(n_qubits), rotation=\"Y\")\n","            qml.StronglyEntanglingLayers(weights, wires=range(n_qubits))\n","            return [qml.expval(qml.PauliZ(w)) for w in range(n_qubits)]\n","\n","        self.qlayer = qml.qnn.TorchLayer(qnode, weight_shapes)\n","\n","        self.post = nn.Sequential(\n","            nn.Linear(n_qubits, 256), nn.ReLU(True),\n","            nn.Linear(256, 7 * 7 * 64), nn.ReLU(True),\n","        )\n","        self.deconv = nn.Sequential(\n","            nn.ConvTranspose2d(64, 32, 4, 2, 1), nn.BatchNorm2d(32), nn.ReLU(True),   # 14x14\n","            nn.ConvTranspose2d(32, 16, 4, 2, 1), nn.BatchNorm2d(16), nn.ReLU(True),   # 28x28\n","            nn.Conv2d(16, out_channels, 3, 1, 1),\n","            nn.Tanh(),\n","        )\n","\n","    def forward(self, z: torch.Tensor) -> torch.Tensor:\n","        x = self.pre(z)\n","        x = self.qlayer(x)\n","        x = self.post(x).view(-1, 64, 7, 7)\n","        return self.deconv(x)\n","\n","\n","# ======================\n","# 🔹 Discriminator (CNN)\n","# ======================\n","class Discriminator(nn.Module):\n","    def __init__(self, in_channels: int = 1):\n","        super().__init__()\n","        self.net = nn.Sequential(\n","            nn.Conv2d(in_channels, 64, 4, 2, 1), nn.LeakyReLU(0.2, inplace=True),\n","            nn.Conv2d(64, 128, 4, 2, 1), nn.BatchNorm2d(128), nn.LeakyReLU(0.2, True),\n","            nn.Conv2d(128, 256, 3, 2, 1), nn.BatchNorm2d(256), nn.LeakyReLU(0.2, True),\n","            nn.Flatten(),\n","            nn.Linear(256 * 4 * 4, 1),\n","        )\n","\n","    def forward(self, x: torch.Tensor) -> torch.Tensor:\n","        return self.net(x).squeeze(1)\n","\n","\n","# ======================\n","# 🔹 Utility Functions\n","# ======================\n","def save_image_grid(tensor, path, nrow=8, normalize=True, value_range=(-1, 1)):\n","    Path(path).parent.mkdir(parents=True, exist_ok=True)\n","    grid = vutils.make_grid(tensor, nrow=nrow, normalize=normalize, value_range=value_range)\n","    vutils.save_image(grid, path)\n","    return path\n","\n","def safe_import_torchmetrics():\n","    try:\n","        from torchmetrics.image.fid import FrechetInceptionDistance\n","        return FrechetInceptionDistance\n","    except Exception:\n","        return None\n","\n","def compute_fid(fake_images: torch.Tensor, real_images: torch.Tensor, device: torch.device):\n","    FID = safe_import_torchmetrics()\n","    if FID is None:\n","        return None\n","\n","    def prep(x):\n","        if x.size(1) == 1:\n","            x = x.repeat(1, 3, 1, 1)\n","        x = (x.clamp(0, 1) * 255.0).to(torch.uint8)\n","        return x\n","\n","    fid = FID(feature=2048).to(device)\n","    fid.update(prep(real_images).to(device), real=True)\n","    fid.update(prep(fake_images).to(device), real=False)\n","    return float(fid.compute().item())\n","\n","def compute_jsd(fake_images: torch.Tensor, real_images: torch.Tensor, num_bins: int = 256) -> float:\n","    try:\n","        fake_flat = fake_images.view(-1).detach().cpu()\n","        real_flat = real_images.view(-1).detach().cpu()\n","\n","        fake_hist = torch.histc(fake_flat, bins=num_bins, min=0.0, max=1.0)\n","        real_hist = torch.histc(real_flat, bins=num_bins, min=0.0, max=1.0)\n","\n","        fake_hist = fake_hist / fake_hist.sum()\n","        real_hist = real_hist / real_hist.sum()\n","        m = 0.5 * (fake_hist + real_hist)\n","\n","        # Use KL divergence: kl(p||q) = sum p * (log p - log q)\n","        kl_fake = (fake_hist * (fake_hist.add(1e-16).log() - m.add(1e-16).log())).sum()\n","        kl_real = (real_hist * (real_hist.add(1e-16).log() - m.add(1e-16).log())).sum()\n","\n","        jsd = 0.5 * (kl_fake + kl_real)\n","        return float(jsd.item())\n","    except Exception as e:\n","        print(\"JSD computation failed:\", e)\n","        return None\n","\n","def _prepare_for_inception(x: torch.Tensor, device: torch.device):\n","    \"\"\"\n","    Convert tensor from range [0,1] to 3-channel, 299x299,\n","    and ImageNet-normalized tensor for Inception v3.\n","    \"\"\"\n","    if x.size(1) == 1:\n","        x = x.repeat(1, 3, 1, 1)\n","    x = F.interpolate(x, size=(299, 299), mode=\"bilinear\", align_corners=False)\n","    mean = torch.tensor([0.485, 0.456, 0.406], device=device).view(1, 3, 1, 1)\n","    std  = torch.tensor([0.229, 0.224, 0.225], device=device).view(1, 3, 1, 1)\n","    x = (x - mean) / std\n","    return x\n","\n","def compute_inception_score(images: torch.Tensor,\n","                            device: torch.device,\n","                            batch_size: int = 32,\n","                            splits: int = 10,\n","                            resize_inputs: bool = True) -> float:\n","    \"\"\"\n","    Robust Inception Score computation.\n","    - images: tensor in [0,1], shape (N, C, H, W)\n","    - returns: float IS or None on failure\n","    \"\"\"\n","    try:\n","        # Load inception with aux_logits=True so pretrained weights match.\n","        inception = models.inception_v3(pretrained=True, aux_logits=True)\n","        # After loading weights, disable aux logits to simplify forward outputs.\n","        inception.aux_logits = False\n","        inception.to(device).eval()\n","\n","        preds = []\n","        N = images.size(0)\n","        with torch.no_grad():\n","            for i in range(0, N, batch_size):\n","                batch = images[i:i+batch_size].to(device)\n","                if resize_inputs:\n","                    batch_in = _prepare_for_inception(batch, device)\n","                else:\n","                    batch_in = batch\n","                    if batch_in.size(1) == 1:\n","                        batch_in = batch_in.repeat(1, 3, 1, 1)\n","\n","                out = inception(batch_in)\n","                # Some versions/models may return a tuple (logits, aux_logits) — handle that.\n","                if isinstance(out, tuple):\n","                    out = out[0]\n","                p = F.softmax(out, dim=1)\n","                preds.append(p.cpu())\n","\n","        preds = torch.cat(preds, dim=0).numpy()  # (N, C)\n","        splits = min(splits, N)\n","        split_scores = []\n","        for k in range(splits):\n","            start = int(k * N / splits)\n","            end   = int((k + 1) * N / splits)\n","            part = preds[start:end, :]\n","            py = np.mean(part, axis=0, keepdims=True)\n","            kl = part * (np.log(part + 1e-16) - np.log(py + 1e-16))\n","            sum_kl = np.sum(kl, axis=1)\n","            avg_kl = np.mean(sum_kl)\n","            split_scores.append(np.exp(avg_kl))\n","        is_score = float(np.mean(split_scores))\n","        return is_score\n","\n","    except Exception as e:\n","        print(\"Inception Score computation failed:\", e)\n","        return None\n","\n","def make_dataloaders(dataset: str, batch_size: int, data_dir: str):\n","    transform = transforms.Compose([\n","        transforms.ToTensor(),\n","        transforms.Normalize(mean=(0.5,), std=(0.5,)),\n","    ])\n","\n","    if dataset.lower() == \"mnist\":\n","        ds = datasets.MNIST(root=data_dir, train=True, download=True, transform=transform)\n","    elif dataset.lower() in [\"fashion\", \"fashionmnist\", \"fashion-mnist\"]:\n","        ds = datasets.FashionMNIST(root=data_dir, train=True, download=True, transform=transform)\n","    else:\n","        raise ValueError(f\"Unknown dataset: {dataset}. Choose 'mnist' or 'fashion'.\")\n","\n","    return DataLoader(ds, batch_size=batch_size, shuffle=True, num_workers=2, pin_memory=torch.cuda.is_available())\n","\n","@torch.no_grad()\n","def sample_fixed(gen, device, outdir, step_tag=\"epoch_0\", n=64, latent_dim=16):\n","    z = torch.randn(n, latent_dim, device=device)\n","    fake = gen(z).cpu()\n","    save_image_grid(fake, str(Path(outdir)/f\"samples_{step_tag}.png\"), nrow=8, normalize=True, value_range=(-1,1))\n","\n","# ======================\n","# 🔹 Training Function\n","# ======================\n","base_drive_outdir = \"/content/drive/MyDrive/QGAN_Outputs\"\n","os.makedirs(base_drive_outdir, exist_ok=True)\n","\n","def make_run_outdir(dataset: str):\n","    timestamp = datetime.datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n","    run_dir = os.path.join(base_drive_outdir, f\"{dataset}_{timestamp}\")\n","    os.makedirs(run_dir, exist_ok=True)\n","    return run_dir\n","\n","def train(epochs=10,\n","          batch_size=64,\n","          latent_dim=64,\n","          n_qubits=6,\n","          q_depth=4,\n","          lr_g=1e-4,\n","          lr_d=2.5e-4,\n","          dataset=\"mnist\",\n","          data_dir=\"./data\",\n","          seed=42):\n","\n","    outdir = make_run_outdir(dataset)\n","\n","    torch.manual_seed(seed)\n","    device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n","    print(\"Using device:\", device)\n","    print(f\"Saving outputs to: {outdir}\")\n","\n","    dl = make_dataloaders(dataset, batch_size, data_dir)\n","\n","    gen  = QuantumGenerator(latent_dim, n_qubits, q_depth, out_channels=1).to(device)\n","    disc = Discriminator(in_channels=1).to(device)\n","\n","    criterion = nn.BCEWithLogitsLoss()\n","    opt_g = optim.Adam(gen.parameters(),  lr=lr_g, betas=(0.5, 0.999))\n","    opt_d = optim.Adam(disc.parameters(), lr=lr_d, betas=(0.5, 0.999))\n","\n","    # First sample\n","    sample_fixed(gen, device, outdir, \"epoch_0\", 64, latent_dim)\n","\n","    # CSV log (include IS column)\n","    csv_path = os.path.join(outdir, \"training_log.csv\")\n","    with open(csv_path, \"w\", newline=\"\") as f:\n","        writer = csv.writer(f)\n","        writer.writerow([\"Epoch\", \"G_Loss\", \"D_Loss\", \"FID\", \"JSD\", \"IS\"])\n","\n","    for epoch in range(1, epochs + 1):\n","        gen.train(); disc.train()\n","        g_loss_sum = d_loss_sum = 0.0\n","\n","        for real, _ in dl:\n","            real = real.to(device)\n","            bsz = real.size(0)\n","            ones = torch.ones(bsz, device=device)\n","            zeros = torch.zeros(bsz, device=device)\n","\n","            # Train D\n","            disc.zero_grad(set_to_none=True)\n","            logits_real = disc(real)\n","            loss_real = criterion(logits_real, ones)\n","\n","            z = torch.randn(bsz, latent_dim, device=device)\n","            with torch.no_grad():\n","                fake = gen(z)\n","            logits_fake = disc(fake.detach())\n","            loss_fake = criterion(logits_fake, zeros)\n","\n","            loss_d = loss_real + loss_fake\n","            loss_d.backward(); opt_d.step()\n","\n","            # Train G\n","            gen.zero_grad(set_to_none=True)\n","            z = torch.randn(bsz, latent_dim, device=device)\n","            fake = gen(z)\n","            logits_fake = disc(fake)\n","            loss_g = criterion(logits_fake, ones)\n","            loss_g.backward(); opt_g.step()\n","\n","            g_loss_sum += loss_g.item() * bsz\n","            d_loss_sum += loss_d.item() * bsz\n","\n","        n = len(dl.dataset)\n","        g_epoch_loss = g_loss_sum / n\n","        d_epoch_loss = d_loss_sum / n\n","        print(f\"Epoch {epoch:03d}/{epochs} | G: {g_epoch_loss:.4f} | D: {d_epoch_loss:.4f}\")\n","\n","        fid = jsd = is_score = None\n","\n","        # ✅ Save images & metrics every 5 epochs\n","        if epoch % 5 == 0:\n","            sample_fixed(gen, device, outdir, f\"epoch_{epoch}\", 64, latent_dim)\n","\n","            # Save models\n","            torch.save(gen.state_dict(),  os.path.join(outdir, f\"gen_epoch{epoch}.pt\"))\n","            torch.save(disc.state_dict(), os.path.join(outdir, f\"disc_epoch{epoch}.pt\"))\n","\n","            try:\n","                gen.eval()\n","                # generate a larger sample for metrics\n","                n_samples = 512\n","                z = torch.randn(n_samples, latent_dim, device=device)\n","                fake = gen(z).detach()  # in [-1,1]\n","                # real samples (try to get same count)\n","                real_batch, _ = next(iter(dl))\n","                real = real_batch[:n_samples].to(device)\n","                # convert to [0,1] for metrics\n","                fake01 = (fake + 1) / 2\n","                real01 = (real + 1) / 2\n","\n","                fid = compute_fid(fake01, real01, device)\n","                jsd = compute_jsd(fake01, real01)\n","\n","                # Inception Score on fake images (range [0,1])\n","                is_score = compute_inception_score(fake01, device, batch_size=32, splits=10)\n","\n","                if fid is not None:\n","                    print(f\"FID: {fid:.3f}\")\n","                if jsd is not None:\n","                    print(f\"JSD: {jsd:.6f}\")\n","                if is_score is not None:\n","                    print(f\"Inception Score: {is_score:.3f}\")\n","\n","            except Exception as e:\n","                print(\"Metric computation skipped:\", e)\n","\n","        # Append log row\n","        with open(csv_path, \"a\", newline=\"\") as f:\n","            writer = csv.writer(f)\n","            writer.writerow([epoch, g_epoch_loss, d_epoch_loss, fid, jsd, is_score])\n","\n","    print(f\"✅ Training complete. Logs, models, and samples saved in: {outdir}\")"],"metadata":{"id":"2AUxtpe4p_9s"},"execution_count":null,"outputs":[]}],"metadata":{"accelerator":"GPU","colab":{"gpuType":"T4","provenance":[],"authorship_tag":"ABX9TyNnLnY9OhEN6gHuAfLyfZzs"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}